# Letöltött forrásdokumentumok (megbízhatatlan, újra letölthető: tools/download_kerettanterv.py,
# tools/build_mapdata.py --download, tools/build_geodata.py --download)
# A sources/**/manifest.json (URL + SHA-256) bekerül a repóba.
sources/**/*.docx
sources/**/*.doc
sources/**/*.pdf
sources/**/_pages/
sources/**/*.geojson
# Földrajz-források (tools/build_geodata.py --download): minden nyers fájl ki, csak a manifest.json be
sources/foldrajz/**
!sources/foldrajz/**/
!sources/foldrajz/**/manifest.json

# Köztes build-fájlok (pandoc nyers kimenete)
build/

__pycache__/
*.pyc

# Letöltött fontok (tools/build_fonts.py --download); csak a sources/fonts/manifest.json kerül be
sources/fonts/*/
